# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/studexa

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password

# Cookie / Session (cross-site config for Render → Vercel)
# For local dev (same origin / localhost):
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# For production (different domains — Render backend + Vercel frontend):
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# Ticketing — resolution emails (Gmail SMTP)
# When an admin marks a ticket as resolved, a notification is sent to the user.
# Leave unset to disable sending (tickets still work; only email is skipped).
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password

# Optional — OTP emails via Brevo (leave unset to skip OTP email delivery)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=StudexaAI

# Optional — AI / Quiz features
# Primary model  : openai/gpt-oss-120b  (Groq free tier — 120B, 131K ctx, best overall)
# Fallback model : qwen/qwen3.6-27b     (auto-switches on rate-limit / quota exhausted)
# GROQ_API_KEY=
# OTP_EXPIRY_MINUTES=10
# AI_DAILY_LIMIT=100

# Optional — Question deduplication TTL (days a question fingerprint is retained)
# QUESTION_HASH_TTL_DAYS=180
